# =====================================================
# SistOpe - variables de entorno
# Rutas relativas a la carpeta raiz del proyecto
# (ejecutar siempre desde la raiz: ./bin/SistOpe ...)
# =====================================================

# Archivo donde se guardan los usuarios (struct Usuario)
USER_FILE=data/USUARIOS.txt

# Archivo donde se guardan los perfiles y sus permisos (struct Perfil)
PERFIL_FILE=data/PERFILES.txt

# Ejecutable de ADMINISTRACION DE USUARIOS Y PERFILES (opcion 1)
ADMIN_BIN=bin/admin

# Ejecutable multiplicador de matrices (opcion 2)
MULTI_BIN=bin/multi

# Ejecutable juego (servidor o cliente) (opcion 3)
JUEGO_SERVIDOR_BIN=bin/servidor
JUEGO_CLIENTE_BIN=bin/cliente

# El servidor exige LOG_FILE; el cliente no lo necesita.
LOG_FILE=data/juego.log

# Red IPv4: PORT 1..65535. HOST aplica al cliente;
# BIND_ADDR al servidor. Si faltan: 127.0.0.1, 5000, 0.0.0.0.
HOST=127.0.0.1
PORT=5000
BIND_ADDR=0.0.0.0

# Carpeta con los libros .txt (usados en las opciones 7 y 8)
LIBROS_DIR=data/LIBROS

# Nombre del perfil con acceso a la opcion 1
ADMIN_PERFIL=ADMIN

# Numero de threads a usar para indice invertido (opcion 8)
N_THREADS=4

# Path del archivo de indice invertido (opcion 8)
INDICE_INVERTIDO_PATH=data/indice_invertido.idx

# Path del archivo de mapeo de libros (opcion 8)
MAPEO_LIBROS_PATH=data/mapeo_libros.txt

# Prioridad: variable exportada por proceso > .env > valor por defecto
# (solo para parametros opcionales). Para activar este ejemplo:
# cp .env.example .env
# N_THREADS, ambas rutas del indice y LOG_FILE no tienen valor por defecto.
# N_THREADS y las rutas se exigen solo al elegir opcion 8;
# LOG_FILE solo al iniciar servidor. HOST/BIND_ADDR aceptan IPv4 literal.
