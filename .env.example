# =====================================================
# SistOpe - variables de entorno
# Rutas relativas a la carpeta raiz del proyecto
# (ejecutar siempre desde la raiz: ./bin/SistOpe ...)
# =====================================================

# Archivo donde se guardan los usuarios (struct Usuario)
USER_FILE=data/USUARIOS.txt

# Archivo donde se guardan los perfiles y sus permisos (struct Perfil)
PERFIL_FILE=data/PERFILES.txt

# Ejecutable de ADMINISTRACION DE USUARIOS Y PERFILES (opcion 1)
ADMIN_BIN=bin/admin

# Ejecutable multiplicador de matrices (opcion 2)
MULTI_BIN=bin/multi

# Carpeta con los libros .txt (usados en las opciones 6 y 7)
LIBROS_DIR=data/LIBROS

# Nombre del perfil con acceso a la opcion 1
ADMIN_PERFIL=ADMIN

# Numero de threads a usar para indice invertido (opcion 8)
N_THREADS=4

# Path del archivo de indice invertido (opcion 8)
INDICE_INVERTIDO_PATH=data/indice_invertido.idx

# Path del archivo de mapeo de libros (opcion 8)
MAPEO_LIBROS_PATH=data/mapeo_libros.txt